Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"AbsdeltaD", "[", "Ne_", "]"}], ":=", 
  RowBox[{"Abs", "[", 
   RowBox[{"Simplify", "[", 
    RowBox[{"ReplaceAll", "[", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"Limit", "[", 
        RowBox[{
         FractionBox[
          RowBox[{"3", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"1", "+", "q"}], ")"}], "l"], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", 
                SuperscriptBox["l", "2"], "-", 
                RowBox[{"3", " ", "l", " ", "q"}], "+", 
                RowBox[{"3", " ", 
                 SuperscriptBox["q", "2"]}]}], ")"}]}], "-", 
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", "q"}], ")"}], "l"], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", 
                SuperscriptBox["l", "2"], "+", 
                RowBox[{"3", " ", "l", " ", "q"}], "+", 
                RowBox[{"3", " ", 
                 SuperscriptBox["q", "2"]}]}], ")"}]}]}], ")"}]}], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", "l"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "+", "l", "-", "q"}], ")"}], " ", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"1", "+", "q"}], ")"}], 
               RowBox[{"1", "+", "l"}]]}], "+", 
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", "q"}], ")"}], 
               RowBox[{"1", "+", "l"}]], " ", 
              RowBox[{"(", 
               RowBox[{"1", "+", "l", "+", "q"}], ")"}]}]}], ")"}]}]], ",", 
         RowBox[{"l", "->", 
          RowBox[{"3", "/", "4"}]}]}], "]"}], "]"}], ",", 
      RowBox[{"q", "->", 
       RowBox[{"100", "*", 
        RowBox[{"Exp", "[", 
         RowBox[{"2", "*", "Ne"}], "]"}]}]}]}], "]"}], "]"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.980951721157852*^9, 3.980951724741254*^9}, {
