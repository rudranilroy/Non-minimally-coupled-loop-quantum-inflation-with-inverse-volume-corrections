Cell["Defining the Riemann tensor:", "Text",
 CellChangeTimes->{
  3.841840005050765*^9},ExpressionUUID->"c0ba7144-3ed1-b849-9069-\
305dcd2c801b"],

Cell[BoxData[
 FormBox[
  RowBox[{"riemann", ":=", 
   RowBox[{"riemann", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"\[Lambda]", "=", "1"}], "nc"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"affine", "\[LeftDoubleBracket]", 
            RowBox[{"\[Rho]", ",", "\[Lambda]", ",", "\[Mu]"}], 
            "\[RightDoubleBracket]"}], " ", 
           RowBox[{"affine", "\[LeftDoubleBracket]", 
            RowBox[{"\[Nu]", ",", "\[Sigma]", ",", "\[Lambda]"}], 
            "\[RightDoubleBracket]"}]}], "-", 
          RowBox[{
           RowBox[{"affine", "\[LeftDoubleBracket]", 
            RowBox[{"\[Sigma]", ",", "\[Lambda]", ",", "\[Mu]"}], 
            "\[RightDoubleBracket]"}], " ", 
           RowBox[{"affine", "\[LeftDoubleBracket]", 
            RowBox[{"\[Nu]", ",", "\[Rho]", ",", "\[Lambda]"}], 
            "\[RightDoubleBracket]"}]}]}], ")"}]}], "-", 
       FractionBox[
        RowBox[{"\[PartialD]", 
         RowBox[{"affine", "\[LeftDoubleBracket]", 
          RowBox[{"\[Nu]", ",", "\[Rho]", ",", "\[Mu]"}], 
          "\[RightDoubleBracket]"}]}], 
        RowBox[{"\[PartialD]", 
         RowBox[{
         "coord", "\[LeftDoubleBracket]", "\[Sigma]", 
          "\[RightDoubleBracket]"}]}],
        MultilineFunction->None], "+", 
       FractionBox[
        RowBox[{"\[PartialD]", 
         RowBox[{"affine", "\[LeftDoubleBracket]", 
          RowBox[{"\[Nu]", ",", "\[Sigma]", ",", "\[Mu]"}], 
          "\[RightDoubleBracket]"}]}], 
        RowBox[{"\[PartialD]", 
         RowBox[{
         "coord", "\[LeftDoubleBracket]", "\[Rho]", 
          "\[RightDoubleBracket]"}]}],
        MultilineFunction->None]}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Mu]", ",", "1", ",", "nc"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Nu]", ",", "1", ",", "nc"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Rho]", ",", "1", ",", "nc"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Sigma]", ",", "1", ",", "nc"}], "}"}]}], "]"}]}]}], 
  TraditionalForm]], "Input",
 CellChangeTimes->{{3.841840016125848*^9, 3.841840016126511*^9}, {
   3.8420246481032867`*^9, 3.8420246496595716`*^9}, {3.8420246987748213`*^9, 
