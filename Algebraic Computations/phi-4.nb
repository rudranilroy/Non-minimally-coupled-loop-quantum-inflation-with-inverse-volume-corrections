  RowBox[{"riemannDn", ":=", 
   RowBox[{"riemannDn", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
